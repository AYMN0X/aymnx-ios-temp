{
  "expo": {
    "name": "AYMNX",
    "slug": "aymnx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aymnx",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111216",
    "splash": {
      "backgroundColor": "#111216",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aymnx.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "AYMNX",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "AYMNX connects to your computer over your local/Tailscale network to stream your personal music files."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111216",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-image",
      "expo-image-picker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.440854060458-3mhav004vt2eb359j9671c6pb25aurcv"
        }
      ],
      "./plugins/withYogaHeaderSearchPaths",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "8afee2b7-ed92-40fc-83f6-9cdc00d9d60c"
      }
    }
  }
}
